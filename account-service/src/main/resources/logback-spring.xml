<?xml version="1.0" encoding="UTF-8"?>

<configuration>
<appender name= "LOGSTASH" class="net.logstash.appender.LogstashTcpSocketAppender">
<destination>localhost:5000</destination>
<encoder class="net.logstash.encoder.LoggingEventCompositeJsonEncoder">
<providers>
	<timestamp/>
	<pattern>
	<pattern>{"service":"account-service"}</pattern>
	</pattern>
</providers>
</encoder>
</appender>
<root level="INFO"><appender-ref ref="LOGSTASH"/></root>
</configuration>